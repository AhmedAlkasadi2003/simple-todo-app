# API Configuration
# In production or when the backend is running, set this to the backend REST API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Data Mode: "mock" (default for standalone frontend demo) or "api" (connect to real backend)
# When set to "mock", sample data is used and local modifications are stored in localStorage.
# When set to "api", all requests hit the real REST API endpoints specified in NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_DATA_MODE=mock
